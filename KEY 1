const express = require('express');
const app = express();

// הגדרת המפתחות המורשים והקישור הישיר לקובץ ב-GitHub (כתובת Raw)
const validKeys = {
    "key1": "https://raw.githubusercontent.com/adir92781/ADIR/main/IL.m3u8"
};

app.get('/play/:secretKey', async (req, res) => {
    const secretKey = req.params.secretKey;

    // בדיקה האם המפתח קיים
    if (!validKeys[secretKey]) {
        return res.status(403).send("Access Denied: Invalid Key");
    }

    try {
        // משיכת הקובץ המקורי מ-GitHub מאחורי הקלעים
        const response = await fetch(validKeys[secretKey]);
        if (!response.ok) throw new Error('Failed to fetch playlist');
        
        const m3uContent = await response.text();

        // החזרת תוכן רשימת ההשמעה ל-Televzio
        res.setHeader('Content-Type', 'audio/x-mpegurl');
        res.send(m3uContent);
    } catch (error) {
        res.status(500).send("Error loading playlist");
    }
});

app.listen(3000, () => {
    console.log("Server running on port 3000");
});
